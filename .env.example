# Copy to .env.development (or .env.production) and fill in.

# Shared HMAC key for the realtime join tokens minted by the Next.js
# platform. It MUST be byte-identical to REALTIME_TOKEN_SECRET on the
# game-platform side, otherwise every join is rejected as a forged
# signature. Generate with:
#   openssl rand -base64 32
REALTIME_TOKEN_SECRET=

# Port the Colyseus server listens on.
PORT=2567
