# Copy to .env.development (or .env.production) and fill in.

# Shared HMAC key for the realtime join tokens minted by the Next.js
# platform. It MUST be byte-identical to REALTIME_TOKEN_SECRET on the
# game-platform side, otherwise every join is rejected as a forged
# signature. Generate with:
#   openssl rand -base64 32
REALTIME_TOKEN_SECRET=

# Port the Colyseus server listens on.
PORT=2567

# PostgreSQL connection used by the @colyseus/admin operator panel (the
# only consumer — rooms, matchmaking and the matchmaker driver stay in
# memory). The panel creates its own `colyseus_*` tables on boot, so it is
# safe to point at an existing PostgreSQL. If this is unset the server still
# boots and serves every game; /admin is simply not mounted.
DATABASE_URL=

# Signs the admin session cookies. REQUIRED in production:
# @colyseus/admin refuses to boot without it rather than issue sessions it
# cannot verify. Generate with:
#   openssl rand -base64 32
JWT_SECRET=tSlUJff9Et4MVzR1Z4L3MEAyWXXL36d6wwRrgq/7S/s=
